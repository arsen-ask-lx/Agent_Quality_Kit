# Пути, в которые сканирующие проверки не заглядывают.
#
# sandbox/ — чужие репозитории, скачанные для замеров: по ним меряют записи каталога, но их долг
# не наш. Без этой строки пять гейтов краснели на чужом коде, и на своём их вердикт становился
# неразличим. Каталог лежит и в .gitignore: он не коммитится.
sandbox

# evals/cases — корпус ЗАВЕДОМО ПЛОХИХ случаев из чужих репозиториев: выдуманные пакеты, битые
# ссылки, хуки в пустоту. Ровно то, что ищут сканирующие проверки, и ровно то, чем они обязаны
# проверяться. Не спрятать — значит получить красное на собственном приборе; это тот же довод,
# что у образцов red/green, только сложены они в другом месте.
evals/cases
