#!/usr/bin/env bash
# temper — запись урока в общий журнал шишек, не выходя из текущего проекта.
#
# ЗАЧЕМ. Журнал уроков обязан быть ОДИН на все проекты, а обжигаемся мы всегда внутри
# конкретного. Если для записи надо открыть второй репозиторий, вспомнить путь и переключить
# окно — записи не будет. Эта команда делает всё сама: дописывает, коммитит, пушит.
#
# ЧЕГО НЕ ДЕЛАЕТ. Не придумывает содержание записи и не решает за человека, урок это или
# продуктовый дефект. Разграничение — в скилле `lesson`.
#
#   temper note "заголовок"     дописать запись (откроет редактор для тела)
#   temper note "заголовок" --stdin   тело читается со стандартного ввода
#   temper where                показать, где лежит журнал
#   temper pull                 обновить журнал из удалённого

set -euo pipefail

die() { printf '%s\n' "$*" >&2; exit 1; }

# --- где лежит журнал -------------------------------------------------------
# Порядок: явная переменная → соседний каталог → домашний. Молча не угадываем:
# если не нашли, говорим, что сделать, — команда, которая тихо ничего не делает,
# хуже отсутствующей.
find_home() {
  if [ -n "${TEMPER_HOME:-}" ]; then
    [ -d "$TEMPER_HOME/.git" ] || die "TEMPER_HOME=$TEMPER_HOME — это не git-репозиторий."
    printf '%s' "$TEMPER_HOME"; return
  fi
  for candidate in "$HOME/projects/temper" "$HOME/temper" "$(dirname "$PWD")/temper"; do
    [ -d "$candidate/.git" ] && { printf '%s' "$candidate"; return; }
  done
  die "Клон журнала не найден.
Сделай один раз:
  git clone https://github.com/arsen-ask-lx/temper.git ~/projects/temper
или укажи путь: export TEMPER_HOME=/путь/к/temper"
}

cmd_where() { find_home; echo; }

cmd_pull() {
  home=$(find_home)
  git -C "$home" pull --ff-only
}

cmd_note() {
  title=${1:-}
  [ -n "$title" ] || die 'Нужен заголовок: temper note "что произошло"'
  shift || true

  home=$(find_home)
  journal="$home/lessons/README.md"
  [ -f "$journal" ] || die "Журнал не найден: $journal"

  project=$(basename "$PWD")
  date=$(date +%Y-%m-%d)

  body_file=$(mktemp)
  trap 'rm -f "$body_file"' EXIT

  if [ "${1:-}" = "--stdin" ]; then
    cat > "$body_file"
  else
    cat > "$body_file" <<'TEMPLATE'
**Класс:** гейт молчал | гейт соврал | правило обошли | прибор соврал | документ соврал

**Что случилось.** Факты: что ожидали, что получили. Числа, если есть.

**Чем это стоило.** Время, что уехало в прод, что переделали.

**Вывод.** 🔧 гейт / 📜 правило / 👤 решение владельца — и конкретно что сделано.

<!-- Строки-подсказки удали. Запись без вывода в журнал не идёт. -->
TEMPLATE
    "${EDITOR:-nano}" "$body_file"
  fi

  grep -q "Вывод" "$body_file" || die "В записи нет раздела «Вывод». Урок без вывода — это история, а не урок."

  {
    printf '\n## %s — %s\n\n' "$date" "$title"
    printf '**Проект:** %s\n\n' "$project"
    cat "$body_file"
  } >> "$journal"

  git -C "$home" add lessons/README.md
  git -C "$home" commit -q -m "lesson($project): $title"
  git -C "$home" push -q && echo "Записано и отправлено: $title" || {
    echo "Записано локально, но push не прошёл. Отправить вручную: git -C $home push" >&2
    exit 1
  }
}

case "${1:-}" in
  note)  shift; cmd_note "$@" ;;
  where) cmd_where ;;
  pull)  cmd_pull ;;
  *) die "temper note \"заголовок\" | temper where | temper pull" ;;
esac
