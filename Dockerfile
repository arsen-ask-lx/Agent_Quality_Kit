# Образ для тех, у кого Node нет и не будет: проект на Python, Go или Rust, где никто его не
# ставил. Всё остальное закрывается иначе — `npx` работает везде, где Node есть, хук pre-commit
# ставит Node себе сам, GitHub Action тоже.
#
# ЗАЧЕМ ИМЕННО DOCKER, А НЕ HOMEBREW И SCOOP. Каждый из них — отдельный репозиторий
# (`homebrew-tap`, `scoop-bucket`), который надо обновлять при каждом выпуске. У нас это уже
# случалось: сторож версий не смотрел на README.ru.md, и там полгода стояла версия на два
# выпуска старше. Второй список, который никто не сторожит, врёт — вопрос только когда.
# Образ собирается тем же прогоном, что и выпуск, из того же тега.
#
# ПОЧЕМУ debian-slim, А НЕ alpine. Гейты — это `sh`, `grep`, `awk`, `find`, `xargs`. В alpine
# это busybox, и его awk другой: нет `nextfile`, иначе работает `tolower`. Наши проверки на
# такой разнице уже горели — 2026-09-08, кириллица в `grep -i` под Git Bash. Образ, в котором
# гейты ведут себя не так, как на машине человека, хуже отсутствия образа: он даёт зелёное,
# которое ничего не значит.
FROM node:22-slim

# git нужен всем проверкам, работающим с дифом (`--since`), и гейту про коммит.
# bash — рецепты каталога написаны на нём явно.
RUN apt-get update \
 && apt-get install -y --no-install-recommends git bash ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# Зависимостей у пакета нет, поэтому ни npm install, ни lock-файла: кладём исходники как есть.
# Это же и проверяемо глазами — весь смысл комплекта в том, что его можно прочитать.
WORKDIR /opt/aqk
COPY package.json ./
COPY tool/ ./tool/
COPY kit/ ./kit/

# Репозиторий человека монтируется сюда. Владельца не меняем: файлы, созданные `init`,
# должны остаться его, а не root-овыми — иначе он не сможет их править у себя.
WORKDIR /work
ENTRYPOINT ["node", "/opt/aqk/tool/program.mjs"]
CMD ["doctor"]
